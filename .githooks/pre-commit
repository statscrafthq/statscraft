#!/bin/sh
# Refuses a commit whose staged files or file names carry names listed in scripts/check-terms.sh,
# and, on the owner's machine, a commit whose staged files carry prose copied from the reference
# manuals (the checker and the manuals are local only, next to the repositories; see
# .claude/skills/clean-room-writing).
set -eu
top=$(git rev-parse --show-toplevel)
"$top/scripts/check-terms.sh" --staged
workspace=$(dirname "$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")")
checker="$workspace/lab/tools/manual_overlap.py"
[ -f "$checker" ] || exit 0
files=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$files" ] || exit 0
cd "$top"
printf '%s\n' "$files" | tr '\n' '\0' | xargs -0 python3 "$checker" --files >/tmp/manual-overlap-$$.txt 2>&1 || {
    cat /tmp/manual-overlap-$$.txt
    rm -f /tmp/manual-overlap-$$.txt
    exit 1
}
rm -f /tmp/manual-overlap-$$.txt
