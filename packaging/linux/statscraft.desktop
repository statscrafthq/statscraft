[Desktop Entry]
Type=Application
Name=StatsCraft
GenericName=Statistics
Comment=Open data files, run syntax and build tables
Exec=statscraft-gui %F
Icon=statscraft
Terminal=false
Categories=Science;Math;
Keywords=statistics;survey;tables;crosstabs;sav;
# application/x-statscraft-sav is the shared-mime-info type for .sav and .zsav; statscraft.xml adds .sps
MimeType=application/x-statscraft-sav;text/x-statscraft-syntax;
# the window's app id, so docks match the window to this entry
StartupWMClass=StatsCraft
