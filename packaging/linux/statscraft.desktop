[Desktop Entry]
Type=Application
Name=Statscraft
GenericName=Statistics
Comment=Open data files, run syntax and build tables
Exec=statscraft-gui %F
Icon=statscraft
Terminal=false
Categories=Science;Math;
Keywords=statistics;survey;tables;crosstabs;sav;
# statscraft.xml defines both types: data files (.sav, .zsav) and syntax files (.sps)
MimeType=application/x-statscraft-data;text/x-statscraft-syntax;
# the window's app id, so docks match the window to this entry; it keeps its first spelling
StartupWMClass=StatsCraft
