<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Info.plist of Statscraft.app; build.sh puts in the version for @VERSION@. -->
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>org.statscraft.Statscraft</string>
	<key>CFBundleName</key>
	<string>Statscraft</string>
	<key>CFBundleDisplayName</key>
	<string>Statscraft</string>
	<key>CFBundleExecutable</key>
	<string>statscraft-gui</string>
	<key>CFBundleIconFile</key>
	<string>Statscraft</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@VERSION@</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>MIT License</string>
	<!-- .sav and .zsav open in the window, .sps in its syntax editor. Statscraft does not own
	     these formats, so it imports their types; it becomes the default only where no other
	     program is. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Statscraft data file</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Default</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.statscraft.sav</string>
				<string>org.statscraft.zsav</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Statscraft syntax file</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Default</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.statscraft.syntax</string>
			</array>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.statscraft.sav</string>
			<key>UTTypeDescription</key>
			<string>Data file (.sav)</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>sav</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.statscraft.zsav</string>
			<key>UTTypeDescription</key>
			<string>Compressed data file (.zsav)</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>zsav</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.statscraft.syntax</string>
			<key>UTTypeDescription</key>
			<string>Syntax file (.sps)</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.plain-text</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>sps</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
